{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "StudyForGovt — Next.js (App Router) frontend for government exam study materials, styled with SCSS modules.",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p ${PORT:-4000}",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky install"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "fast-check": "^3.23.2",
    "husky": "^8.0.3",
    "sass": "^1.83.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.9"
  }
}
