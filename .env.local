# Local development environment for the Next.js frontend.
# Next.js loads .env.local automatically (unlike .env.example, which is docs only).
# NEXT_PUBLIC_* values are inlined into the client bundle at build/start time,
# so restart the dev server after changing this file.

# Point the browser at the backend API (backend runs on PORT=4001 locally).
NEXT_PUBLIC_API_BASE_URL="http://localhost:4001"

# Public Razorpay Key Identifier used by Razorpay Checkout in the browser.
# Non-secret publishable key — safe to inline. The Key Secret stays backend-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_TB3fah91mrEFzv"

# https://razorpay.com/docs/errors/payments/cards/
# https://razorpay.com/docs/payments/payments/test-card-details/

temp