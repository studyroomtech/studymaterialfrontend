# Base URL of the Backend API consumed by the browser (Req 1.10).
# Read at request time by hooks/api/apiClient.ts via NEXT_PUBLIC_API_BASE_URL.
# Leave unset to fall back to same-origin (relative) requests.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4001"

# Public Razorpay Key Identifier used by Razorpay Checkout in the browser
# (Req 12.5). Read by the PaymentModal via NEXT_PUBLIC_RAZORPAY_KEY_ID; it is a
# non-secret, publishable key that is safe to inline into the client bundle.
#
# SECURITY (Req 12.17): Only this public NEXT_PUBLIC_* key id may live in the
# frontend. NEVER place the Razorpay Key Secret (RAZORPAY_KEY_SECRET) or the
# Razorpay Webhook Secret in the frontend — those stay in the backend only.
# Any NEXT_PUBLIC_* value is inlined into the client bundle and shipped to the
# browser, so it must never hold a secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
